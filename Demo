namespace MusicalScalePlayer;

public class MusicalNote
{
    public string Name { get; set; }
    public double Frequency { get; set; }
    public int Duration { get; set; }

    public MusicalNote(string name, double frequency, int duration)
    {
        Name = name;
        Frequency = frequency;
        Duration = duration;
    }
}
